{
  "name": "skillstream",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/ensure-infra.mjs && turbo run dev",
    "dev:app": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @skillstream/api prisma:generate",
    "db:migrate": "pnpm --filter @skillstream/api prisma:migrate",
    "db:seed": "pnpm --filter @skillstream/api prisma:seed",
    "db:studio": "pnpm --filter @skillstream/api prisma:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}

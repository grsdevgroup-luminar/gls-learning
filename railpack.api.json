{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": [
        "corepack enable",
        "corepack prepare pnpm@11.4.0 --activate",
        "pnpm install --frozen-lockfile --prefer-offline"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "pnpm --filter @grslearning/api exec prisma generate",
        "pnpm --filter @grslearning/shared build",
        "PLAYWRIGHT_BROWSERS_PATH=0 pnpm --filter @grslearning/api exec playwright install chromium",
        "pnpm --filter @grslearning/api build"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "libnss3",
      "libnspr4",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdrm2",
      "libdbus-1-3",
      "libxkbcommon0",
      "libxcomposite1",
      "libxdamage1",
      "libxfixes3",
      "libxrandr2",
      "libgbm1",
      "libasound2",
      "libpango-1.0-0",
      "libcairo2",
      "libatspi2.0-0",
      "libxshmfence1",
      "fonts-liberation",
      "fonts-noto-color-emoji",
      "fonts-noto-core"
    ],
    "startCommand": "pnpm start:api"
  }
}

# Copy to .env for local development.
NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://skillstream:skillstream@localhost:5432/skillstream?schema=public

# Auth — generate strong secrets in production (openssl rand -base64 48)
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_prod_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_prod_0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Cookies / CORS
COOKIE_DOMAIN=
WEB_ORIGIN=http://localhost:3000

# Optional integrations (filled in per phase)
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
RESEND_API_KEY=

# Copy to .env for local development.
NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://skillstream:skillstream@localhost:5432/skillstream?schema=public

# Auth — generate a strong secret in production (openssl rand -base64 48)
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_prod_0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Cookies / CORS
COOKIE_DOMAIN=
# apps/web's dev script runs on :3001 (see apps/web/package.json), not Next's default :3000
WEB_ORIGIN=http://localhost:3001


REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
# Efficient DRM: sign playback tokens locally instead of one API call per play.
# One-time setup: curl -X POST \
#   https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/stream/keys \
#   -H "Authorization: Bearer $CLOUDFLARE_STREAM_TOKEN"
# Store the returned `id` here and base64-encode the returned `pem` for the PEM var:
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=

#currency exchange rates 
FX_RATES_URL=https://open.er-api.com/v6/latest/USD

# Transactional email (Resend — see console.resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@skillstream.dev
FRONTEND_URL=http://localhost:3001
SENTRY_DSN=

# SMS reminders (Twilio). Without all three, SmsService logs instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Swagger docs
DOCS_USER=
DOCS_PASSWORD=
# Public base URL of this API, used as the "try it out" target in the docs.
# Leave blank to use a relative server (correct when docs share the API origin).
PUBLIC_API_URL=

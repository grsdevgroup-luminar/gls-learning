# Copy to .env for local development.
NODE_ENV=development
PORT=4000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://skillstream:skillstream@localhost:5432/skillstream?schema=public

# Auth — generate a strong secret in production (openssl rand -base64 48)
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_prod_0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Cookies / CORS
COOKIE_DOMAIN=
# apps/web's dev script runs on :3001 (see apps/web/package.json), not Next's default :3000
WEB_ORIGIN=http://localhost:3001


REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect Express onboarding redirect URLs. Required whenever
# STRIPE_SECRET_KEY is set — the hosted onboarding form redirects back to
# these when the instructor finishes or refreshes an expired link.
STRIPE_CONNECT_RETURN_URL=http://localhost:3001/instructor/earnings?stripe=onboarded
STRIPE_CONNECT_REFRESH_URL=http://localhost:3001/instructor/earnings?stripe=refresh
# Instructor payout fee model. Basis points (500 = 5%) for platform
# commission; minimum net (cents) that must reach the payee after fees.
PAYOUT_PLATFORM_FEE_BPS=500
PAYOUT_MIN_NET_CENTS=2500
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "true" = api-m.sandbox.paypal.com, "false" = api-m.paypal.com. Defaults to
# sandbox outside production. Sandbox credentials on the live host fail with
# `invalid_client`, so set this explicitly when deploying with sandbox keys.
PAYPAL_SANDBOX=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
# Efficient DRM: sign playback tokens locally instead of one API call per play.
# One-time setup: curl -X POST \
#   https://api.cloudflare.com/client/v4/accounts/$ACCOUNT_ID/stream/keys \
#   -H "Authorization: Bearer $CLOUDFLARE_STREAM_TOKEN"
# Store the returned `id` here and base64-encode the returned `pem` for the PEM var:
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=
# Webhook signing secret from PUT /accounts/:id/stream/webhook (see Cloudflare Stream docs).
# Register once per account, pointing at POST /api/webhooks/cloudflare-stream:
# curl -X PUT "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/stream/webhook" \
#   -H "Authorization: Bearer $CLOUDFLARE_STREAM_TOKEN" \
#   --data '{"notificationUrl":"https://your-api.example/api/webhooks/cloudflare-stream"}'
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Tus upload policy (optional — defaults shown)
# STREAM_MAX_DURATION_SECONDS=7200
# STREAM_MAX_OUTSTANDING_UPLOADS=3
# STREAM_UPLOAD_RESERVATION_HOURS=24
# STREAM_STALE_UPLOADING_HOURS=48
# STREAM_FAILED_RETENTION_DAYS=7

#currency exchange rates 
FX_RATES_URL=https://open.er-api.com/v6/latest/USD

# Transactional email
# EMAIL_DRIVER selects the transport adapter. Auto-resolves in this order:
#   1. explicit EMAIL_DRIVER (resend | smtp | log)
#   2. `resend` when RESEND_API_KEY is set
#   3. `smtp`   when SMTP_HOST is set (local Mailpit)
#   4. `log`   (no delivery — logs the envelope)
# Local dev: run `docker compose up -d mailpit` and set EMAIL_DRIVER=smtp.
# Prod: set EMAIL_DRIVER=resend + RESEND_API_KEY.
# EMAIL_DRIVER=smtp
EMAIL_FROM=noreply@skillstream.dev
# EMAIL_REPLY_TO=support@skillstream.dev
# Resend adapter (see console.resend.com). Required when EMAIL_DRIVER=resend.
RESEND_API_KEY=
# Legacy — superseded by EMAIL_FROM; kept as a fallback for one release.
RESEND_FROM_EMAIL=noreply@skillstream.dev

# SMTP adapter — local dev uses Mailpit (docker-compose service `mailpit`).
# Web UI: http://localhost:8025. Mailpit accepts any auth by default.
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
FRONTEND_URL=http://localhost:3001
SENTRY_DSN=

# SMS reminders (Twilio). Without all three, SmsService logs instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Swagger docs
DOCS_USER=
DOCS_PASSWORD=
# Public base URL of this API, used as the "try it out" target in the docs.
# Leave blank to use a relative server (correct when docs share the API origin).
PUBLIC_API_URL=

# Logging: development writes JSON Lines to this daily file and remains readable
# on the console. Production must use stdout and never creates a local log file.
LOG_DESTINATION=file
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14

# ── Lesson resource storage ──────────────────────────────────────────────────
# Driver defaults: `local` in dev/test, `s3` in production. Override to point a
# staging box at the prod bucket.
STORAGE_DRIVER=local
# Where LocalDriver writes uploads (relative to the API cwd, git-ignored).
STORAGE_LOCAL_DIR=uploads
# Per-file cap in bytes. 10 MB.
STORAGE_MAX_BYTES=10485760
# TTL for signed GET URLs on private S3 buckets, in seconds.
STORAGE_SIGNED_URL_TTL_SEC=3600

# S3-compatible bucket (Railway object storage, AWS S3, Cloudflare R2). All
# four vars below are REQUIRED when STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most non-AWS S3 clones need path-style URLs; leave blank to use client default.
S3_FORCE_PATH_STYLE=true
# If the bucket is public-read (CDN in front), set this and skip signing.
S3_PUBLIC_BASE_URL=

# Checkout geo verification (MaxMind). Disabled by default for local dev.
# GEOIP_CHECKOUT_ENABLED=true
# MAXMIND_COUNTRY_DB_PATH=./data/geoip/GeoLite2-Country.mmdb
# MAXMIND_ANONYMOUS_IP_DB_PATH=./data/geoip/GeoIP2-Anonymous-IP.mmdb

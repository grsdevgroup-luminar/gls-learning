// SkillStream production data model.
// Money is stored as integer cents (USD). Enums mirror @skillstream/shared.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  DELIVERY_PARTNER
  ORG_ADMIN
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum CourseRevisionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
}

enum DeliveryPartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ReferralStatus {
  PENDING
  CONFIRMED
  PAID
  /// Fully or partially reversed because the underlying order was refunded
  /// (see `reversedCents`) — a terminal state only once the whole commission
  /// has been reversed; a partial reversal keeps the prior status.
  REVERSED
}

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
}

enum OrgMemberRole {
  ADMIN
  MEMBER
}

enum OrgSuspensionMode {
  LOCK_NOW
  GRACE_PERIOD
}

enum PayeeType {
  INSTRUCTOR
  DELIVERY_PARTNER
}

enum PayoutMethod {
  PAYPAL
  BANK
  STRIPE
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum LessonType {
  VIDEO
  QUIZ
  ARTICLE
}

enum UploadStatus {
  CREATED
  UPLOADING
  PROCESSING
  READY
  FAILED
  ABANDONED
}

enum InstructorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NameChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
enum CourseDeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}
enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum StudentStatus {
  ACTIVE
  IDLE
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum RatingStage {
  STARTED
  IN_PROGRESS
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  SSLCOMMERZ
}

enum CouponType {
  PERCENT
  FIXED
  FREE
}

enum CouponScope {
  GLOBAL
  COURSE
}

enum ReminderTrigger {
  IDLE
  LOW_PROGRESS
  ABANDONED_CART
  ALMOST_DONE
  NEW_CONTENT
}

enum ReminderChannel {
  EMAIL
  SMS
}

enum ReminderStatus {
  SENT
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

/// In-app notification events, Phase 1. Each maps to one write inside the same
/// transaction as the state change it describes (see NOTIFICATION_SYSTEM_PLAN.md).
enum CreditLedgerReason {
  GRANT_REFUND
  SPEND_CHECKOUT
  ADJUST_MANUAL
}

enum NotificationEvent {
  ORDER_PAID
  ORDER_REFUNDED
  CREDIT_GRANTED
  CERTIFICATE_ISSUED
  INSTRUCTOR_APPLICATION_APPROVED
  INSTRUCTOR_APPLICATION_REJECTED
  DELIVERY_PARTNER_APPLICATION_APPROVED
  DELIVERY_PARTNER_APPLICATION_REJECTED
  PAYOUT_REQUESTED
  PAYOUT_APPROVED
  PAYOUT_PAID
  PAYOUT_REJECTED
  NAME_CHANGE_REJECTED
  NAME_CHANGE_REQUESTED
  NAME_CHANGE_APPROVED
  EXPERTISE_CHANGE_REQUESTED
  EXPERTISE_CHANGE_APPROVED
  EXPERTISE_CHANGE_REJECTED
  REFERRAL_CONFIRMED
  // Phase 3 — social & ambient
  COURSE_NEW_REVIEW
  COURSE_NEW_ENROLLMENT
  ORDER_NEW_PURCHASE
  COURSE_UPDATED_BY_ADMIN
  ORG_MEMBER_JOINED
  ORG_SEATS_LOW
  ORG_INVITE_EXPIRED
  ORG_INVITE_RECEIVED
  TABLE_SIZE_WARNING
  ORG_MEMBER_REMOVED
  COURSE_DELETED_BY_ADMIN
  EMAIL_DELIVERY_FAILED
  INSTRUCTOR_APPLICATION_SUBMITTED
  DELIVERY_PARTNER_APPLICATION_SUBMITTED
  COURSE_DELETION_REQUESTED
  COURSE_DELETION_REQUEST_APPROVED
  COURSE_DELETION_REQUEST_REJECTED
  ORG_INVITE_DECLINED
  DELIVERY_PARTNER_INVITE_DECLINED
  DELIVERY_PARTNER_INVITE_RECEIVED
  DELIVERY_PARTNER_MEMBER_JOINED
  ORG_MEMBER_RESTORED
  DELIVERY_PARTNER_MEMBER_RESTORED
  DELIVERY_PARTNER_COMMISSION_CHANGED
  PAYOUT_REQUESTED_ADMIN
  COURSE_REVISION_REQUESTED
}

// ─── Identity & roles ─────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  nameChangeCount    Int      @default(0)
  avatar             String?
  /// Internal storage key for a platform-uploaded avatar (e.g.
  /// `avatars/{userId}/{ulid}.jpg`). Null when the user set an external URL.
  /// Kept separate so the resolver can re-sign S3 URLs on session read.
  avatarKey          String?
  country            String?
  /// E.164, e.g. +8801712345678. Optional: SMS reminders are skipped without it.
  phone              String?
  role               UserRole @default(STUDENT)
  emailVerified      Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studentProfile             StudentProfile?
  instructorProfile          InstructorProfile?

  nameChangeRequests      InstructorNameChangeRequest[]
  expertiseChangeRequests InstructorExpertiseChangeRequest[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  enrollments                Enrollment[]
  quizResults                QuizResult[]
  lessonNotes                LessonNote[]
  quizAttempts               QuizAttempt[]
  reviews                    Review[]
  comments                   Comment[]
  helpfulReviewVotes         ReviewHelpful[]
  orders                     Order[]
  reminderLogs               ReminderLog[]
  couponRedemptions          CouponRedemption[]
  authoredCourses            Course[]                @relation("InstructorCourses")
  categoryProposals          Category[]              @relation("CategoryProposals")
  deliveryPartner            DeliveryPartner?
  deliveryPartnerMemberships DeliveryPartnerMember[]
  orgMemberships             OrgMember[]
  payoutAccount              PayoutAccount?
  payouts                    Payout[]
  cart                       Cart?
  notifications              Notification[]
  creditLedger               StudentCreditLedger[]   @relation("CreditLedgerOwner")
  creditGrants               StudentCreditLedger[]   @relation("CreditLedgerAdmin")
  /// Denormalized — kept in sync transactionally on notification create/read,
  /// never derived from a live COUNT(*). See NOTIFICATION_SYSTEM_PLAN.md.
  unreadNotificationCount    Int                     @default(0)
  uploads                    Upload[]
  editedEmailTemplates       EmailTemplate[]
  courseDeletionRequests     CourseDeletionRequest[]

  submittedCourseRevisions   CourseRevisionRequest[] @relation("RevisionSubmitter")

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model StudentProfile {
  userId               String        @id
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  streakDays           Int           @default(0)
  status               StudentStatus @default(ACTIVE)
  totalSpentCents      Int           @default(0)
  notificationPrefs    Json          @default("{}")
  interestCategories   String[]      @default([])
  interestKeywords     String[]      @default([])
  interestsCompletedAt DateTime?
}

model InstructorProfile {
  userId        String           @id
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String           @default("")
  bio           String           @default("")
  expertise     String?
  ratingAvg     Float            @default(0)
  studentCount  Int              @default(0)
  courseCount   Int              @default(0)
  earningsCents Int              @default(0)
  status        InstructorStatus @default(PENDING)
  sampleUrl     String?
  linkedinUrl   String?
  twitterUrl    String?
  youtubeUrl    String?
  facebookUrl   String?
  otherUrl      String?
}

model InstructorNameChangeRequest {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentName   String
  requestedName String
  status        NameChangeRequestStatus @default(PENDING)
  requestedAt   DateTime               @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?
  note          String?

  @@index([status])
  @@index([userId, status])
}

model InstructorExpertiseChangeRequest {
  id                 String                 @id @default(cuid())
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentExpertise   String?
  requestedExpertise String
  status             NameChangeRequestStatus @default(PENDING)
  requestedAt        DateTime               @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?
  note               String?

  @@index([status])
  @@index([userId, status])
}
/// An instructor's request to delete a course they own — course deletion can
/// affect enrolled students and revenue, so an instructor can only ever
/// request it; the course is only actually deleted once an admin approves.
/// courseId is SetNull (not Cascade) and courseTitle is snapshotted at
/// request time, so this row survives as an audit trail past the very
/// approval that deletes the course it refers to.
model CourseDeletionRequest {
  id           String                      @id @default(cuid())
  courseId     String?
  course       Course?                     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseTitle  String
  instructorId String
  instructor   User                        @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  reason       String
  status       CourseDeletionRequestStatus @default(PENDING)
  requestedAt  DateTime                    @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewNote   String?

  @@index([status])
  @@index([courseId])
  @@index([instructorId])
}
model CourseRevisionRequest {
  id              String               @id @default(cuid())
  courseId        String
  course          Course               @relation("CourseEditRequests", fields: [courseId], references: [id], onDelete: Cascade)
  revisionCourseId String               @unique
  revisionCourse  Course               @relation("RevisionEditRequest", fields: [revisionCourseId], references: [id], onDelete: Cascade)
  instructorId    String
  instructor      User                 @relation("RevisionSubmitter", fields: [instructorId], references: [id], onDelete: Cascade)
  status          CourseRevisionStatus @default(PENDING)
  requestedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNote      String?

  @@index([status])
  @@index([courseId])
  @@index([instructorId])
}
model InstructorApplication {
  id          String           @id @default(cuid())
  userId      String?
  name        String
  email       String
  expertise   String
  headline    String
  bio         String
  sampleUrl   String?
  linkedinUrl String?
  twitterUrl  String?
  youtubeUrl  String?
  facebookUrl String?
  otherUrl    String?
  cvName      String?
  cvKey       String?
  cvSizeLabel String?
  status      InstructorStatus @default(PENDING)
  appliedAt   DateTime         @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  note        String?

  @@index([status])
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  status       CategoryStatus @default(ACTIVE)
  proposedById String?
  proposedBy   User?          @relation("CategoryProposals", fields: [proposedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([proposedById])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Course {
  id                 String       @id @default(cuid())
  courseNumber       String       @unique
  slug               String       @unique
  title              String
  subtitle           String       @default("")
  description        String       @default("")
  category           String
  isoStandard        String       @default("")
  level              CourseLevel  @default(ALL_LEVELS)
  thumbnail          String       @default("")
  instructorId       String
  instructor         User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  basePriceCents     Int
  originalPriceCents Int?
  language           String       @default("English")
  status             CourseStatus @default(DRAFT)
  bestseller         Boolean      @default(false)
  whatYouLearn       String[]
  requirements       String[]
  ratingAvg          Float        @default(0)
  reviewCount        Int          @default(0)
  ratingWeightedCount Float       @default(0)
  completedReviewCount Int        @default(0)
  studentCount       Int          @default(0)
  revenueCents       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  publishedAt        DateTime?

  /// Independent of org assignment — see CourseOrgAssignment. PRIVATE hides a
  /// course from the public catalog/direct-link entirely; org membership (via
  /// an assignment row) is what grants access. Assigning a course to an org
  /// never changes this field either way (assignment = distribution, not
  /// privacy) — see OrganizationsService.assignCourse.
  visibility CourseVisibility @default(PUBLIC)

  sections                   Section[]
  enrollments                Enrollment[]
  reviews                    Review[]
  comments                   Comment[]
  orderItems                 OrderItem[]
  coupons                    Coupon[]
  cartItems                  CartItem[]
  uploads                    Upload[]
  orgAssignments             CourseOrgAssignment[]
  deliveryPartnerAssignments DeliveryPartnerCourseAssignment[]
  campaignCourses            DeliveryPartnerCampaignCourse[]
  deletionRequests           CourseDeletionRequest[]
  editRequests               CourseRevisionRequest[] @relation("CourseEditRequests")
  revisionOfId               String?
  revisionOf                 Course? @relation("CourseRevisions", fields: [revisionOfId], references: [id], onDelete: Cascade)
  revisions                  Course[] @relation("CourseRevisions")
  editRequest                CourseRevisionRequest? @relation("RevisionEditRequest")

  @@index([revisionOfId])
  @@index([status])
  @@index([instructorId])
  @@index([category])
  @@index([visibility])
}

/// A course made available to a company account. Many-to-many: one course can
/// be curated into several orgs, and one org can have many courses. For a
/// PRIVATE course this row is what grants access at all; for a PUBLIC course
/// it's pure curation (the course was already open to everyone).
model CourseOrgAssignment {
  id        String       @id @default(cuid())
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([courseId, orgId])
  @@index([courseId])
  @@index([orgId])
}

model Section {
  id               String   @id @default(cuid())
  courseId         String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  order            Int      @default(0)
  sourceSectionId  String?
  archivedAt       DateTime?
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id              String     @id @default(cuid())
  sectionId       String
  section        Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title          String
  durationSec    Int        @default(0)
  type           LessonType @default(VIDEO)
  preview        Boolean    @default(false)
  order          Int        @default(0)
  articleContent String?
  resources      Json       @default("[]")
  cfVideoUid     String?
  pptxStorageKey String?
  pptxName       String?
  pptxSizeLabel  String?
  pptxDurationSec Int       @default(0)
  createdAt       DateTime   @default(now())
  sourceLessonId  String?
  archivedAt      DateTime?

  quiz           Quiz?
  lessonProgress LessonProgress[]
  quizResults    QuizResult[]
  quizAttempts   QuizAttempt[]
  notes          LessonNote[]
  upload         Upload?

  @@index([sectionId])
}

/// Application-owned Cloudflare Stream upload reservation. Source of truth for
/// ownership, attachability, and playback readiness (see video-upload-tus-plan).
model Upload {
  id              String       @id @default(cuid())
  ownerUserId     String
  owner           User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  cloudflareUid   String?      @unique
  tusUploadUrl    String?
  courseId        String?
  course          Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId        String?      @unique
  lesson          Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  filename        String
  bytes           BigInt
  fileFingerprint String?
  status          UploadStatus @default(CREATED)
  failureReason   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  expiresAt       DateTime
  completedAt     DateTime?
  readyAt         DateTime?

  @@index([ownerUserId, status])
  @@index([status, expiresAt])
  @@index([courseId])
}

model Quiz {
  id        String         @id @default(cuid())
  lessonId  String         @unique
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  passScore Int            @default(70)
  questions QuizQuestion[]
}

model QuizQuestion {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt      String
  explanation String?
  order       Int          @default(0)
  options     QuizOption[]

  @@index([quizId])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)

  @@index([questionId])
}

// ─── Learning ─────────────────────────────────────────────────────────────────

model Enrollment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(IN_PROGRESS)
  // Actual video-playback seconds reported by the player, accumulated on every
  // heartbeat — replaying the same segment counts again. Distinct from "time
  // learned" (sum of durationSec for lessons ever completed; progress rows are
  // kept after un-complete), computed on read in EnrollmentService.toDto.
  watchTimeSec   Int              @default(0)
  enrolledAt     DateTime         @default(now())
  lastActivityAt DateTime         @default(now())
  completedAt    DateTime?

  lessonProgress LessonProgress[]
  certificate    Certificate?

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([enrolledAt, courseId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // `false` means previously completed then unchecked — the row stays so
  // time learned remains credited. Sequential access and progress % ignore it.
  completed    Boolean    @default(true)
  pptxCompleted Boolean   @default(false)
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

/// A learner's private notes on one lesson. Separate from LessonProgress so
/// notes survive un-completing a lesson, and exist before any progress does.
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  body      String
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model QuizResult {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  bestScore     Int      @default(0)
  lastScore     Int      @default(0)
  attempts      Int      @default(0)
  passed        Boolean  @default(false)
  lastAttemptAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, lessonId])
}

model Certificate {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  /// Cascades with the enrollment (and transitively the course): a course
  /// deletion still destroys every certificate issued for it, even ones
  /// already earned. AuthoringService only gates deletion on *unfinished*
  /// enrollments, not this — see countUnfinishedEnrollments.
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  serial       String     @unique
  learnerName  String
  courseNumber String
  pdfUrl       String?
  issuedAt     DateTime   @default(now())
}

// ─── Engagement ───────────────────────────────────────────────────────────────

model Review {
  id                 String        @id @default(cuid())
  courseId           String
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  progressPercent    Int           @default(0)
  ratingStage        RatingStage   @default(STARTED)
  ratingWeight       Float         @default(0.35)
  // Legacy storage retained for database compatibility; not exposed in review APIs or UI.
  title              String
  body               String
  status             ReviewStatus  @default(PENDING)
  // Keeps the moderation state to restore when an admin unhides the review.
  statusBeforeHidden ReviewStatus?
  helpful            Int           @default(0)
  createdAt          DateTime      @default(now())
  helpfulVotes       ReviewHelpful[]

  @@unique([courseId, userId])
  @@index([courseId, status])
}

// ─── Commerce ─────────────────────────────────────────────────────────────────

/// Course discussion. Replies are one level deep; comments are publicly
/// readable and any logged-in user may post or reply.
model Comment {
  id        String    @id @default(cuid())
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  body      String
  createdAt DateTime  @default(now())

  @@index([courseId, createdAt])
  @@index([parentId, createdAt])
}

model ReviewHelpful {
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([reviewId, userId])
  @@index([userId])
}

model Order {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id])
  country             String?
  subtotalCents       Int
  discountCents       Int            @default(0)
  /// Store credit applied to this order at checkout. Reduces the amount charged
  /// to the payment gateway. Refunds of orders where this is > 0 are blocked in
  /// v1 to avoid compounding (see REFUND_TO_CREDIT_PLAN.md).
  creditAppliedCents  Int            @default(0)
  /// Cumulative refunded amount across all refund actions on this order.
  /// Equals SUM(items.refundedCents). Denormalized for quick "remaining refundable"
  /// computation and status decisions. Full refund → status REFUNDED; partial → PARTIALLY_REFUNDED.
  refundedCents       Int            @default(0)
  totalCents          Int
  currency            String         @default("USD")
  couponCode          String?
  gateway             PaymentGateway
  status              OrderStatus    @default(PENDING)
  providerPaymentId   String?
  providerRef         String?
  providerRedirectUrl String?
  /// Client-supplied Idempotency-Key for POST /checkout/session. Scoped per
  /// user so two accounts can reuse the same client-side UUID without colliding.
  /// Null on legacy rows; new rows created via the checkout flow always set it.
  idempotencyKey      String?
  createdAt           DateTime       @default(now())
  paidAt              DateTime?

  /// Set when the buyer checked out with a delivery-partner campaign code —
  /// the sole attribution path (there is no non-campaign referral). Denormalized
  /// alongside the FK so reporting doesn't need to join DeliveryPartnerReferral.
  partnerId String?

  campaignId   String?
  campaign     DeliveryPartnerCampaign? @relation(fields: [campaignId], references: [id])
  campaignCode String?

  items           OrderItem[]
  redemptions     CouponRedemption[]
  partnerReferral DeliveryPartnerReferral?
  creditLedger    StudentCreditLedger[]

  @@unique([userId, idempotencyKey], name: "user_idempotency_key")
  @@index([userId])
  @@index([status])
  @@index([partnerId])
  @@index([campaignId])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course @relation(fields: [courseId], references: [id])
  titleSnapshot String
  priceCents    Int
  /// Cumulative store-credit refund granted against this item.
  /// Access is revoked only when refundedCents == priceCents (item fully refunded).
  refundedCents Int    @default(0)

  @@index([orderId])
}

/// Append-only ledger for student store credit. Balance = SUM(amountCents)
/// per (userId, currency). Positive rows = credit granted (e.g. GRANT_REFUND),
/// negative rows = credit spent (SPEND_CHECKOUT). See REFUND_TO_CREDIT_PLAN.md.
model StudentCreditLedger {
  id          String             @id @default(cuid())
  userId      String
  amountCents Int
  currency    String
  reason      CreditLedgerReason
  orderId     String?
  adminUserId String?
  comment     String?
  createdAt   DateTime           @default(now())

  user      User   @relation("CreditLedgerOwner", fields: [userId], references: [id], onDelete: Cascade)
  adminUser User?  @relation("CreditLedgerAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, currency, createdAt])
  @@index([orderId])
}

model Coupon {
  code          String      @id
  type          CouponType
  value         Int
  description   String      @default("")
  minSpendCents Int?
  scope         CouponScope @default(GLOBAL)
  courseId      String?
  course        Course?     @relation(fields: [courseId], references: [id])
  expiresAt     DateTime
  usageLimit    Int         @default(0)
  used          Int         @default(0)
  active        Boolean     @default(true)
  /// Storefront promo banner. At most one coupon may be featured at a time —
  /// enforced by a partial unique index (see the migration), not just by service code.
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponCode String
  coupon     Coupon   @relation(fields: [couponCode], references: [code], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([couponCode, orderId])
  @@index([userId])
}

// ─── Pricing / localization ─────────────────────────────────────────────────

model PricingTier {
  id         String   @id
  name       String
  multiplier Float
  countries  String[]
}

model CountryOverride {
  country     String  @id
  flag        String
  type        String // "tier" | "flat_percent"
  tierId      String?
  flatPercent Float?
}

model Region {
  code        String    @id
  country     String
  flag        String
  currency    String
  symbol      String
  locale      String    @default("en-US")
  fxRate      Float
  // Null = never refreshed by the FX job (seeded value). Surfaced in admin so a
  // silently-failing feed shows up as a stale rate instead of hiding in logs.
  fxUpdatedAt DateTime?
  multiplier  Float
  tierId      String?
  override    Boolean   @default(false)
}

// ─── Marketing / automation ───────────────────────────────────────────────────

model AutomationRule {
  id        String            @id @default(cuid())
  name      String
  trigger   ReminderTrigger
  condition String
  /// Trigger-specific eligibility thresholds (inactiveDays, pendingHours, etc.).
  params    Json              @default("{}")
  channels  ReminderChannel[]
  template  String
  active    Boolean           @default(true)
  sentCount Int               @default(0)
  cooldownHours Int           @default(168)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

/// Admin-editable override of one email type's subject/body. `key` matches an
/// entry in the code-side EMAIL_TEMPLATES registry (apps/api/src/modules/email/
/// email-templates.registry.ts) — a plain string, not an enum, so new email
/// types never need a migration. Absence of a row means "use the registry
/// default", so this table only ever holds customizations, never the full set.
model EmailTemplate {
  id              String   @id @default(cuid())
  key             String   @unique
  subject         String
  body            String
  ctaLabel        String?
  updatedByUserId String?
  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model ReminderLog {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  ruleId    String?
  channel   ReminderChannel
  /// A ReminderTrigger, NotificationEvent, or EmailTemplate.key value — plain
  /// string so this log covers the marketing-automation sweep, Phase 1's
  /// transactional events, and every EmailTemplate-backed send, not just the
  /// original 5 reminder triggers.
  trigger   String
  subject   String
  status    ReminderStatus  @default(SENT)
  createdAt DateTime        @default(now())

  @@index([userId])
}

// ─── Notifications ─────────────────────────────────────────────────────────────

/// In-app notification feed, Phase 1. Plain table for now — see
/// NOTIFICATION_SYSTEM_PLAN.md "Scale & retention" for when/how this converts to
/// a partitioned table (not needed at current scale).
model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     NotificationEvent
  title     String
  body      String
  /// Deep link into the app, e.g. "/dashboard/billing". Optional — some events
  /// (e.g. a rejection) may have nothing sensible to link to.
  href      String?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, readAt])
}

/// Generalized opt-in store, one row per (user, event). Covers three
/// otherwise-separate universes under one flexible key: the 5 ReminderTrigger
/// names (marketing automation), the 9 NotificationEvent names (Phase 1
/// transactional/lifecycle events), and the 4 admin alert keys — `event` is a
/// plain string rather than an enum specifically so it can hold any of them
/// without a three-way enum union. `inApp` exists for a future "mute this in
/// the bell" feature; nothing reads it yet — the in-app write is unconditional
/// by design (opt-out, not opt-in).
model NotificationPreference {
  userId String
  event  String
  inApp  Boolean @default(true)
  email  Boolean @default(true)
  sms    Boolean @default(false)

  @@id([userId, event])
}

// ─── Ops ──────────────────────────────────────────────────────────────────────

/// Platform-wide settings. Exactly one row: `id` is pinned to "singleton" so a
/// second row cannot be created, and reads upsert the defaults on first access.
model PlatformSettings {
  id                String   @id @default("singleton")
  platformName      String   @default("SkillStream")
  supportEmail      String   @default("support@skillstream.dev")
  /// Gateway kill-switches — enforced at checkout, not just displayed.
  stripeEnabled     Boolean  @default(true)
  paypalEnabled     Boolean  @default(true)
  sslcommerzEnabled Boolean  @default(true)
  /// Admin notification toggles, keyed by id. Enforced in AdminAlertsService:
  /// event alerts (newEnrollment/newReview) and the daily digest all check these.
  notifications     Json     @default("{}")
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  /// The user this action happened *to*, when that's different from who
  /// performed it (e.g. a student removed from an org/partner) — the generic
  /// interceptor can't populate this (it only sees route params), so it's
  /// only ever set by explicit AuditService.record() calls.
  affectedUserId String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([affectedUserId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

// ─── Delivery Partners ─────────────────────────────────────────────────────────────

model DeliveryPartner {
  id                   String                @id @default(cuid())
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissionPercent    Float                 @default(10)
  region               String                @default("")
  status               DeliveryPartnerStatus @default(PENDING)
  totalEarningsCents   Int                   @default(0)
  pendingEarningsCents Int                   @default(0)
  paidEarningsCents    Int                   @default(0)
  referralCount        Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  referrals         DeliveryPartnerReferral[]
  courseAssignments DeliveryPartnerCourseAssignment[]
  campaigns         DeliveryPartnerCampaign[]

  @@index([status])
}

model DeliveryPartnerApplication {
  id           String                @id @default(cuid())
  userId       String?
  name         String
  email        String
  country      String?
  /// Applicant-defined label/value pairs, e.g. [{"label":"Company","value":"Acme Inc"}].
  customFields Json                  @default("[]")
  /// Uploaded supporting documents: [{"title","key","name","sizeLabel"}].
  documents    Json                  @default("[]")
  /// The applicant's own requested commission rate — a starting point for the
  /// admin's review, not binding; the admin sets the actual rate on approval.
  expectedCommissionPercent Float?
  status       DeliveryPartnerStatus @default(PENDING)
  appliedAt    DateTime              @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  note         String?

  @@index([status])
}

model DeliveryPartnerReferral {
  id              String          @id @default(cuid())
  partnerId       String
  partner         DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  orderId         String          @unique
  order           Order           @relation(fields: [orderId], references: [id])
  commissionCents Int
  /// Cumulative amount reversed off `commissionCents` from refunds — lets a
  /// multi-item order be refunded across several admin actions without
  /// over-reversing. Status only flips to REVERSED once this reaches
  /// `commissionCents`.
  reversedCents   Int             @default(0)
  status          ReferralStatus  @default(PENDING)
  createdAt       DateTime        @default(now())

  @@index([partnerId])
}

/// GLOBAL (default) applies to every course, same as before. SPECIFIC scopes
/// the campaign to the courses listed in DeliveryPartnerCampaignCourse —
/// independent of DeliveryPartnerCourseAssignment (which courses a partner may
/// distribute to invited members); a campaign may discount any published
/// course regardless of assignment.
enum DeliveryPartnerCampaignScope {
  GLOBAL
  SPECIFIC
}

/// An admin-created, time-boxed discount campaign for one approved delivery
/// partner. The generated `code` is entered manually at checkout — the only
/// way a delivery partner attributes and discounts an order (see
/// DeliveryPartnerService.resolveCampaign). Discount + commission (on the
/// discounted total, via DeliveryPartnerReferral) both resolve through this
/// row. A partner may hold any number of campaigns at once, including
/// several active ones with overlapping or identical date ranges — each is
/// redeemed by its own distinct `code`, so there's no ambiguity at checkout.
model DeliveryPartnerCampaign {
  id              String          @id @default(cuid())
  partnerId       String
  partner         DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  code            String          @unique
  discountPercent Float
  startDate       DateTime
  endDate         DateTime
  active          Boolean         @default(true)
  /// 0 = unlimited. Counts *paid* orders only — incremented alongside
  /// DeliveryPartnerService.confirmReferral (on payment confirmation), not at
  /// checkout-session creation, so an abandoned cart never consumes a seat.
  usageLimit      Int             @default(0)
  usageCount      Int             @default(0)
  scope           DeliveryPartnerCampaignScope    @default(GLOBAL)
  campaignCourses DeliveryPartnerCampaignCourse[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  orders Order[]

  @@index([partnerId])
}

/// Many-to-many scope for a SPECIFIC-scope campaign. Ignored (and kept empty)
/// while the owning campaign's scope is GLOBAL.
model DeliveryPartnerCampaignCourse {
  id         String                  @id @default(cuid())
  campaignId String
  campaign   DeliveryPartnerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())

  @@unique([campaignId, courseId])
  @@index([campaignId])
  @@index([courseId])
}

/// A course a delivery partner has been approved to redistribute, admin-only
/// to create (mirrors CourseOrgAssignment/Organization — see
/// DELIVERY_PARTNER_MEMBER_FLOW_PLAN.md §3). Access is per-course: inviting a
/// member to one assignment does not grant access to the partner's other
/// assigned courses. Unlike Organization.usedSeats, this never decrements —
/// once a member claims a seat it stays spent even if the partner later
/// removes them, so a partner can't cycle members through a capped course to
/// invite more people than the cap allows (see DeliveryPartnerService.
/// removeMember).
model DeliveryPartnerCourseAssignment {
  id        String          @id @default(cuid())
  courseId  String
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  partnerId String
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// 0 = unlimited — same convention as DeliveryPartnerCampaign.usageLimit.
  memberCap Int             @default(0)
  /// Lifetime count of accepted invitations — only ever increases (see
  /// DeliveryPartnerService.removeMember/adminRestoreMember).
  usedSeats Int             @default(0)
  /// Lifetime count of invitations ever created against this assignment —
  /// incremented only at invite-creation time, never decremented (not on
  /// revoke, decline, or member removal). Distinct from usedSeats (which only
  /// counts accepted invitations): this counts every invite sent, so "how
  /// many people has this partner ever invited" survives a partner
  /// unilaterally removing someone.
  totalInvitesSent Int      @default(0)
  createdAt DateTime        @default(now())

  members     DeliveryPartnerMember[]
  invitations DeliveryPartnerInvitation[]

  @@unique([courseId, partnerId])
  @@index([courseId])
  @@index([partnerId])
}

/// One row per course-access grant, not per person — the same email can have
/// a separate row against a second course-assignment if the partner invites
/// them again for a different course. Flat membership, no role tiers: a
/// delivery partner is one person, unlike an org which can have multiple
/// admins.
///
/// Soft-deleted on removal (removedAt set, row kept) rather than hard-deleted
/// — so a platform admin can see a member a partner removed and restore them
/// (see AdminService/DeliveryPartnerService restore endpoints). A row with
/// removedAt set no longer counts as active membership anywhere access is
/// checked (EnrollmentRepository queries filter it out explicitly).
model DeliveryPartnerMember {
  id                 String                          @id @default(cuid())
  courseAssignmentId String
  courseAssignment   DeliveryPartnerCourseAssignment @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name               String
  email              String
  joinedAt           DateTime                        @default(now())
  removedAt          DateTime?
  removedBy          String?
  removedReason      String?

  @@index([courseAssignmentId, email])
  @@index([courseAssignmentId])
  @@index([userId])
}

model DeliveryPartnerInvitation {
  id                 String                          @id @default(cuid())
  courseAssignmentId String
  courseAssignment   DeliveryPartnerCourseAssignment @relation(fields: [courseAssignmentId], references: [id], onDelete: Cascade)
  email              String
  token              String                          @unique
  expiresAt          DateTime
  claimedAt          DateTime?
  declinedAt         DateTime?
  createdAt          DateTime                        @default(now())

  @@index([courseAssignmentId])
  @@index([token])
}

// ─── B2B Organizations ────────────────────────────────────────────────────────

model Organization {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  domain         String?
  logoUrl        String?
  adminEmail     String
  status         OrgStatus          @default(TRIAL)
  suspensionMode OrgSuspensionMode?
  accessLocksAt  DateTime?
  seatCount      Int                @default(10)
  /// Billable member seats in use — OrgMember rows with role MEMBER only.
  /// The provisioned org admin (OrgMember.role ADMIN) does not count.
  usedSeats      Int                @default(0)
  /// Lifetime count of invitations ever created for this org — incremented
  /// only at invite-creation time, never decremented. See the identical field
  /// on DeliveryPartnerCourseAssignment for why this exists separately from
  /// usedSeats.
  totalInvitesSent Int              @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  members           OrgMember[]
  invitations       OrgInvitation[]
  courseAssignments CourseOrgAssignment[]

  @@index([status])
}

/// Soft-deleted on removal (removedAt set, row kept) rather than hard-deleted
/// — see the identical note on DeliveryPartnerMember for why.
model OrgMember {
  id            String        @id @default(cuid())
  orgId         String
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name          String
  email         String
  role          OrgMemberRole @default(MEMBER)
  joinedAt      DateTime      @default(now())
  removedAt     DateTime?
  removedBy     String?
  removedReason String?

  @@index([orgId, email])
  @@index([orgId])
  @@index([userId])
}

model OrgInvitation {
  id        String        @id @default(cuid())
  orgId     String
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String
  role      OrgMemberRole @default(MEMBER)
  token     String        @unique
  expiresAt DateTime
  claimedAt DateTime?
  declinedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([orgId])
  @@index([token])
}

// ─── Payouts ──────────────────────────────────────────────────────────────────

/// Where a payee's money goes. One per user, set by the payee. `details` is the
/// free-form destination (PayPal email or bank details) an admin reads to
/// execute the transfer manually — this system does not move money itself.
model PayoutAccount {
  userId    String       @id
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    PayoutMethod
  details   String
  updatedAt DateTime     @updatedAt
}

/// A single payout in the request→approve→paid ledger, shared by instructors and
/// delivery partners. `destination` snapshots the account details at request time so
/// history stays accurate even if the payee later edits their account.
///
/// `amountCents` is the gross withdrawn from the payee's available balance;
///
///
/// `netCents` is what actually reaches the payee after platform + gateway fees.
/// `providerRef` stores the Stripe transfer id (`tr_xxx`) for STRIPE payouts.
model Payout {
  id               String       @id @default(cuid())
  payeeUserId      String
  payee            User         @relation(fields: [payeeUserId], references: [id], onDelete: Cascade)
  payeeType        PayeeType
  amountCents      Int
  netCents         Int          @default(0)
  platformFeeCents Int          @default(0)
  stripeFeeCents   Int          @default(0)
  status           PayoutStatus @default(REQUESTED)
  method           PayoutMethod
  destination      String
  providerRef      String?
  note             String?
  requestedAt      DateTime     @default(now())
  processedAt      DateTime?
  processedBy      String?

  @@index([payeeUserId])
  @@index([status])
}

// ─── Shopping cart ────────────────────────────────────────────────────────────

model Cart {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode   String?
  /// Mutually exclusive with couponCode at checkout — only one discount code
  /// applies at a time. See DeliveryPartnerCampaign.
  campaignCode String?
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cartId, courseId])
  @@index([courseId])
}
